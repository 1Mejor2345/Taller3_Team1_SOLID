public class JuegoPaga extends Juegos{

    private double precio;

    private boolean estaPagado;

    public JuegoPaga(double precio){
        this.precio = precio;
        estaPagado = false;
    }

    @Override
    public void descargar(){

        if(!estaPagado){
            System.out.println("Necesita comprar el juego!");
            Compras.comprarJuego(this.getId());
        }
        else{
            System.out.println("Descargando juego...\nCosto: " + precio);
            // Ejecución del juego
        }
        
        
    }

    public void setEstaPagado(boolean estaPagado){
        this.estaPagado = estaPagado;
    }

}