
public class Estudiante {

    private String cedula;

    private String nombre;

    private String apellido;

    private double notaEvaluacion;

    public Estudiante(String cedula, String nombre, String apellido, double notaEvaluacion){
        this.cedula = cedula;
        this.nombre = nombre;
        this.apellido = apellido;
        this.notaEvaluacion = notaEvaluacion;
    }

    public String getCedula(){
        return cedula;
    }

    public String getNombre(){
        return nombre;
    }

    public String getApellido(){
        return apellido;
    }

    public double getNotaEvaluacion(){
        return notaEvaluacion;
    }
    
}

public class EvaluadorCalificaciones{

    public boolean estaAprobado(Estudiante estudiante){

        if(estudiante == null) throw new IllegalArgumentException("El parámetro enviado es nulo");

        return estudiante.getNotaEvaluacion() >= 60; 
    }

    public boolean excelenciaAcademica(Estudiante estudiante){

        if(estudiante == null) throw new IllegalArgumentException("El parámetro enviado es nulo");

        return estudiante.getNotaEvaluacion() >= 90; 
    }


}
